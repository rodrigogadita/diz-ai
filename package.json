{
  "name": "diz-ai",
  "displayName": "Diz Aí: prompts com a sua voz",
  "description": "Fale a ideia do seu jeito. O Diz Aí transcreve, o Claude lapida num prompt claro e ele chega pronto no Claude Code, no Copilot ou no terminal. Feito para o português do Brasil.",
  "version": "1.1.0",
  "publisher": "rodrigogadita",
  "author": {
    "name": "Rodrigo Silva",
    "url": "https://github.com/rodrigogadita"
  },
  "license": "MIT",
  "icon": "media/icone.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigogadita/diz-ai"
  },
  "bugs": {
    "url": "https://github.com/rodrigogadita/diz-ai/issues"
  },
  "homepage": "https://github.com/rodrigogadita/diz-ai#readme",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "keywords": [
    "voz",
    "ditado",
    "prompt",
    "claude code",
    "copilot",
    "speech to text",
    "whisper",
    "português",
    "pt-br",
    "dictation",
    "voice"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dizAi",
          "title": "Diz Aí",
          "icon": "media/barra.svg"
        }
      ]
    },
    "views": {
      "dizAi": [
        {
          "type": "webview",
          "id": "dizAi.aoVivo",
          "name": "Ao vivo",
          "icon": "media/barra.svg"
        },
        {
          "id": "dizAi.historico",
          "name": "Histórico",
          "icon": "media/barra.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dizAi.historico",
        "contents": "Fale a ideia do seu jeito. O Diz Aí escreve o prompt e entrega no chat.\n[$(mic) Ditar agora](command:dizAi.ditar)\nAtalho: Ctrl+Alt+D para falar, Ctrl+Alt+Enter para enviar.\n[Primeiros passos](command:dizAi.primeirosPassos)"
      }
    ],
    "commands": [
      { "command": "dizAi.ditar", "title": "Ditar", "category": "Diz Aí", "icon": "$(mic)" },
      { "command": "dizAi.ditarNoChat", "title": "Ditar direto no chat", "category": "Diz Aí", "icon": "$(comment-discussion)" },
      { "command": "dizAi.lapidar", "title": "Lapidar a fala em prompt", "category": "Diz Aí", "icon": "$(sparkle)" },
      { "command": "dizAi.ajustar", "title": "Ajustar o prompt por voz", "category": "Diz Aí", "icon": "$(edit)" },
      { "command": "dizAi.enviar", "title": "Enviar", "category": "Diz Aí", "icon": "$(send)" },
      { "command": "dizAi.enviarFala", "title": "Enviar a fala sem lapidar", "category": "Diz Aí" },
      { "command": "dizAi.cancelar", "title": "Cancelar gravação ou lapidação", "category": "Diz Aí" },
      { "command": "dizAi.trocarModo", "title": "Trocar o modo de escrita", "category": "Diz Aí", "icon": "$(symbol-namespace)" },
      { "command": "dizAi.trocarMotor", "title": "Trocar o motor de voz", "category": "Diz Aí" },
      { "command": "dizAi.definirChaveWhisper", "title": "Definir chave do Whisper", "category": "Diz Aí" },
      { "command": "dizAi.novoBloco", "title": "Bloco novo", "category": "Diz Aí", "icon": "$(new-file)" },
      { "command": "dizAi.abrirBloco", "title": "Abrir", "category": "Diz Aí" },
      { "command": "dizAi.reenviar", "title": "Enviar de novo", "category": "Diz Aí", "icon": "$(send)" },
      { "command": "dizAi.copiar", "title": "Copiar prompt", "category": "Diz Aí", "icon": "$(copy)" },
      { "command": "dizAi.excluir", "title": "Excluir", "category": "Diz Aí", "icon": "$(trash)" },
      { "command": "dizAi.atualizarHistorico", "title": "Atualizar", "category": "Diz Aí", "icon": "$(refresh)" },
      { "command": "dizAi.abrirPasta", "title": "Abrir a pasta dos prompts", "category": "Diz Aí", "icon": "$(folder-opened)" },
      { "command": "dizAi.configurar", "title": "Configurações", "category": "Diz Aí", "icon": "$(gear)" },
      { "command": "dizAi.primeirosPassos", "title": "Primeiros passos", "category": "Diz Aí" },
      { "command": "dizAi.configuracoesWindows", "title": "Abrir configurações de voz do Windows", "category": "Diz Aí" },
      { "command": "dizAi.menu", "title": "Menu", "category": "Diz Aí" },
      { "command": "dizAi.diagnosticar", "title": "Testar o microfone", "category": "Diz Aí", "icon": "$(debug)" },
      { "command": "dizAi.mostrarLog", "title": "Mostrar o log", "category": "Diz Aí" }
    ],
    "menus": {
      "editor/title": [
        { "command": "dizAi.ditar", "when": "dizAi.noBloco", "group": "navigation@1" },
        { "command": "dizAi.lapidar", "when": "dizAi.noBloco", "group": "navigation@2" },
        { "command": "dizAi.ajustar", "when": "dizAi.noBloco", "group": "navigation@3" },
        { "command": "dizAi.enviar", "when": "dizAi.noBloco", "group": "navigation@4" },
        { "command": "dizAi.trocarModo", "when": "dizAi.noBloco", "group": "navigation@5" }
      ],
      "view/title": [
        { "command": "dizAi.diagnosticar", "when": "view == dizAi.aoVivo", "group": "navigation@1" },
        { "command": "dizAi.configurar", "when": "view == dizAi.aoVivo", "group": "navigation@2" },
        { "command": "dizAi.ditar", "when": "view == dizAi.historico", "group": "navigation@1" },
        { "command": "dizAi.novoBloco", "when": "view == dizAi.historico", "group": "navigation@2" },
        { "command": "dizAi.atualizarHistorico", "when": "view == dizAi.historico", "group": "navigation@3" },
        { "command": "dizAi.abrirPasta", "when": "view == dizAi.historico", "group": "navigation@4" },
        { "command": "dizAi.configurar", "when": "view == dizAi.historico", "group": "navigation@5" }
      ],
      "view/item/context": [
        { "command": "dizAi.reenviar", "when": "view == dizAi.historico && viewItem == dizAi.bloco", "group": "inline@1" },
        { "command": "dizAi.copiar", "when": "view == dizAi.historico && viewItem == dizAi.bloco", "group": "inline@2" },
        { "command": "dizAi.excluir", "when": "view == dizAi.historico && viewItem == dizAi.bloco", "group": "z@1" }
      ],
      "commandPalette": [
        { "command": "dizAi.abrirBloco", "when": "false" },
        { "command": "dizAi.reenviar", "when": "false" },
        { "command": "dizAi.copiar", "when": "false" },
        { "command": "dizAi.excluir", "when": "false" },
        { "command": "dizAi.atualizarHistorico", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "dizAi.ditar", "key": "ctrl+alt+d", "mac": "cmd+alt+d" },
      { "command": "dizAi.ditarNoChat", "key": "ctrl+alt+m", "mac": "cmd+alt+m" },
      { "command": "dizAi.lapidar", "key": "ctrl+alt+l", "mac": "cmd+alt+l" },
      { "command": "dizAi.ajustar", "key": "ctrl+alt+r", "mac": "cmd+alt+r" },
      { "command": "dizAi.enviar", "key": "ctrl+alt+enter", "mac": "cmd+alt+enter", "when": "dizAi.noBloco && !findWidgetVisible" },
      { "command": "dizAi.cancelar", "key": "escape", "when": "dizAi.ouvindo || dizAi.lapidando" }
    ],
    "configuration": {
      "title": "Diz Aí",
      "properties": {
        "dizAi.motor": {
          "type": "string",
          "enum": ["windows", "whisper", "vscode"],
          "enumDescriptions": [
            "Ditado do Windows (Win+H): online, ótimo em português, pontua sozinho e digita no campo em foco",
            "Whisper (Groq, OpenAI ou servidor local): o mais preciso para termos técnicos",
            "VS Code Speech: offline, só dita em editores de texto"
          ],
          "default": "windows",
          "order": 1,
          "description": "Quem transforma a sua voz em texto."
        },
        "dizAi.modo": {
          "type": "string",
          "default": "estruturado",
          "order": 2,
          "markdownDescription": "Como a fala vira prompt: `estruturado`, `limpo`, `bug`, `funcionalidade`, `refatoracao`, `revisao`, `pergunta` ou o `id` de um modo seu em `#dizAi.modosPersonalizados#`."
        },
        "dizAi.destino": {
          "type": "string",
          "enum": ["auto", "claude", "chat", "terminal", "area"],
          "enumDescriptions": [
            "Claude Code se estiver instalado; senão o chat do VS Code (Copilot); senão a área de transferência",
            "Caixa de mensagem da extensão Claude Code",
            "Chat do VS Code (GitHub Copilot e outros)",
            "Terminal (Claude Code CLI, Aider, Codex…): cola sem apertar Enter",
            "Só copia"
          ],
          "default": "auto",
          "order": 3,
          "description": "Para onde o prompt vai quando você envia."
        },
        "dizAi.mostrarPainel": {
          "type": "boolean",
          "default": true,
          "order": 3.5,
          "description": "No primeiro ditado da sessão, abrir o painel Ao vivo (ondas da voz, o que você disse e o prompt nascendo)."
        },
        "dizAi.lapidarAoVivo": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Lapidar sozinho a cada pausa na fala. O prompt já está pronto quando você envia."
        },
        "dizAi.pausaAoVivoMs": {
          "type": "number",
          "default": 2000,
          "minimum": 800,
          "order": 5,
          "description": "Silêncio (ms) que conta como pausa para lapidar ao vivo e para ouvir os comandos de voz."
        },
        "dizAi.comandosEnviar": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["pode enviar", "manda ver", "manda bala", "envia aí", "pode mandar", "enviar prompt"],
          "order": 6,
          "description": "Frases que, ditas no FIM da fala, enviam o prompt sem tocar no teclado."
        },
        "dizAi.glossario": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["Claude Code", "VS Code", "GitHub", "Copilot", "JSON", "API", "Python", "JavaScript", "TypeScript", "Node.js", "React", "SQL", "Docker", "PowerShell", "commit", "branch", "pull request", "deploy", "endpoint"],
          "order": 7,
          "description": "Grafia certa de nomes que a voz costuma errar (produtos, sistemas, pessoas, siglas). Vai para o Whisper e para o lapidador."
        },
        "dizAi.atalhosDeVoz": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "order": 8,
          "markdownDescription": "Frase falada → texto fixo. Ex.: `{ \"meu repositório\": \"github.com/fulano/projeto\", \"regra de testes\": \"Rode os testes antes de dizer que terminou.\" }`"
        },
        "dizAi.modosPersonalizados": {
          "type": "array",
          "default": [],
          "order": 9,
          "items": {
            "type": "object",
            "required": ["id", "nome", "instrucoes"],
            "properties": {
              "id": { "type": "string", "description": "Identificador curto, sem espaço" },
              "nome": { "type": "string", "description": "Nome que aparece no menu" },
              "detalhe": { "type": "string", "description": "Uma linha explicando o modo" },
              "instrucoes": { "type": "string", "description": "Como organizar o prompt" }
            }
          },
          "markdownDescription": "Seus modos de escrita. Ex.: `{ \"id\": \"tela\", \"nome\": \"Tela nova\", \"instrucoes\": \"Organize em Tela, Campos, Ações e Regras visuais.\" }`"
        },
        "dizAi.idiomaDoPrompt": {
          "type": "string",
          "enum": ["pt-BR", "en", "mesmo"],
          "enumDescriptions": ["Português do Brasil", "Inglês (você fala em português, o prompt sai em inglês)", "O mesmo idioma da fala"],
          "default": "pt-BR",
          "order": 10,
          "description": "Idioma do prompt final."
        },
        "dizAi.contexto": {
          "type": "array",
          "items": { "type": "string", "enum": ["arquivo", "selecao", "erros", "branch"] },
          "default": ["arquivo", "selecao", "erros", "branch"],
          "uniqueItems": true,
          "order": 11,
          "description": "O que o lapidador vê do editor para entender \"esse arquivo\", \"esse erro\", \"aqui\". Só entra no prompt quando você se refere a ele."
        },
        "dizAi.instrucoesExtras": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "order": 12,
          "description": "Preferências que o lapidador sempre segue. Ex.: \"Sempre peça testes com pytest.\""
        },
        "dizAi.modelo": {
          "type": "string",
          "enum": ["sonnet", "haiku", "opus"],
          "default": "sonnet",
          "order": 13,
          "description": "Modelo que lapida (usa o login do Claude Code). O Sonnet foi o mais rápido e o mais fiel nos testes."
        },
        "dizAi.colarAutomatico": {
          "type": "boolean",
          "default": true,
          "order": 14,
          "description": "Colar sozinho na caixa do Claude Code. Desligado, só copia e põe o foco lá."
        },
        "dizAi.esperaColar": {
          "type": "number",
          "default": 350,
          "order": 15,
          "description": "Milissegundos entre focar a caixa do Claude e colar. Aumente se a colagem falhar."
        },
        "dizAi.whisper.provedor": {
          "type": "string",
          "enum": ["groq", "openai", "local"],
          "default": "groq",
          "order": 20,
          "description": "Onde o Whisper roda. A chave fica no cofre do VS Code (comando \"Diz Aí: definir chave do Whisper\")."
        },
        "dizAi.whisper.url": {
          "type": "string",
          "default": "",
          "order": 21,
          "description": "Endereço /v1/audio/transcriptions. Vazio = o padrão do provedor."
        },
        "dizAi.whisper.modelo": {
          "type": "string",
          "default": "",
          "order": 22,
          "description": "Modelo de transcrição. Vazio = whisper-large-v3-turbo (Groq), gpt-4o-transcribe (OpenAI)."
        },
        "dizAi.pasta": {
          "type": "string",
          "default": "",
          "order": 30,
          "description": "Onde guardar os blocos (fala.md, prompt.md). Vazio = Documentos/Diz Aí."
        },
        "dizAi.claudeCaminho": {
          "type": "string",
          "default": "",
          "order": 31,
          "description": "Caminho do executável claude. Vazio = o da extensão Claude Code ou o do PATH."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dizAi.primeirosPassos",
        "title": "Diz Aí: primeiros passos",
        "description": "Em 2 minutos você está fazendo prompts com a sua voz.",
        "steps": [
          {
            "id": "voz",
            "title": "Prepare o ditado do Windows",
            "description": "Ative a pontuação automática e o reconhecimento de fala online.\n[Abrir Digitação](command:dizAi.configuracoesWindows?%5B%22typing%22%5D)\n[Abrir Privacidade de fala](command:dizAi.configuracoesWindows?%5B%22privacy-speech%22%5D)",
            "media": { "markdown": "media/passos/1-voz.md" }
          },
          {
            "id": "ditar",
            "title": "Fale a sua ideia",
            "description": "Aperte Ctrl+Alt+D e fale do seu jeito, com pausa, correção e tudo. Aperte de novo para parar.\n[$(mic) Ditar agora](command:dizAi.ditar)",
            "media": { "markdown": "media/passos/2-ditar.md" },
            "completionEvents": ["onCommand:dizAi.ditar"]
          },
          {
            "id": "lapidar",
            "title": "Veja o prompt nascer",
            "description": "A cada pausa o Claude reescreve a fala ao lado, já organizada. Quer forçar? Ctrl+Alt+L.\n[$(sparkle) Lapidar](command:dizAi.lapidar)",
            "media": { "markdown": "media/passos/3-lapidar.md" },
            "completionEvents": ["onCommand:dizAi.lapidar"]
          },
          {
            "id": "enviar",
            "title": "Envie sem tocar no teclado",
            "description": "Termine a fala com \"pode enviar\" ou aperte Ctrl+Alt+Enter. O prompt cai na caixa do Claude Code.\n[$(send) Enviar](command:dizAi.enviar)",
            "media": { "markdown": "media/passos/4-enviar.md" },
            "completionEvents": ["onCommand:dizAi.enviar"]
          },
          {
            "id": "modo",
            "title": "Escolha o modo e o motor",
            "description": "Relato de bug, funcionalidade, refatoração, revisão… E, se quiser precisão máxima, o Whisper.\n[Trocar o modo](command:dizAi.trocarModo)\n[Trocar o motor de voz](command:dizAi.trocarMotor)",
            "media": { "markdown": "media/passos/5-modos.md" },
            "completionEvents": ["onCommand:dizAi.trocarModo"]
          }
        ]
      }
    ]
  }
}
